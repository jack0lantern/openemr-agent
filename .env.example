# PostgreSQL for conversation persistence (required for chat saving)
# Local dev: use localhost. Docker: use postgres host (compose overrides with postgres:5432)
DATABASE_URL=postgresql+asyncpg://openemr_agent:openemr_agent@localhost:5432/openemr_agent

# Leave unset to use auto-registration (with OPENEMR_AUTO_REGISTER=true). Set after manual registration.
# OPENEMR_CLIENT_ID=
PRIVATE_KEY_PATH=/certs/private_key.pem
# OAuth2 endpoints. OPENEMR_REGISTRATION_URL is derived from OPENEMR_TOKEN_URL if not set.
# Local: http://localhost:8300/oauth2/default/token
# Docker: http://openemr/oauth2/default/token
OPENEMR_TOKEN_URL=http://openemr/oauth2/default/token
OPENEMR_FHIR_URL=http://openemr/apis/default/fhir
# When site_addr_oath is browser-reachable (e.g. http://localhost:8300), set this so JWT aud matches.
# OPENEMR_JWT_AUDIENCE=http://localhost:8300/oauth2/default/token

# OAuth registration: when true and OPENEMR_CLIENT_ID is unset, agent auto-registers on startup.
OPENEMR_AUTO_REGISTER=true

# Use mock data (true) or live OpenEMR FHIR API + external APIs (false). Default true for demo.
USE_MOCK_DATA=true

# External data sources (when USE_MOCK_DATA=false): MedlinePlus Connect, RxNav
# MEDLINE_CONNECT_URL=https://connect.medlineplus.gov/service
# RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
# EXTERNAL_DATA_CACHE_TTL_MINUTES=720
# LLM Provider Keys
ANTHROPIC_API_KEY=

# Token usage and cost tracking (default: true)
# ENABLE_COST_TRACKING=true
# ANTHROPIC_INPUT_PRICE_PER_1M=1.0
# ANTHROPIC_OUTPUT_PRICE_PER_1M=5.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# LangSmith observability (optional - traces appear in LangSmith dashboard)
# Get API key from https://smith.langchain.com project settings
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=openemr-agent

# Demo: include tool calls in chat response for UI debug box
# DEBUG_TOOL_CALLS=true

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openemr

DEBUG_TOOL_CALLS=true
PATIENT_AUTH_REQUIRED=false
STAFF_AUTH_REQUIRED=false