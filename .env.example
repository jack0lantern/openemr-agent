OPENEMR_CLIENT_ID=ai-agent-client-id
PRIVATE_KEY_PATH=/certs/private_key.pem
# LLM Provider Keys
ANTHROPIC_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Langfuse observability (optional - traces appear in Langfuse dashboard)
# Get keys from https://cloud.langfuse.com project settings
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com  # US region

# Demo: include tool calls in chat response for UI debug box
# DEBUG_TOOL_CALLS=true